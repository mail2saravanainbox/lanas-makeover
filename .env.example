# ─────────────────────────────────────────────────────────────────────────────
#  LANA'S MAKEOVER — ENVIRONMENT
#  Copy to `.env.local` for development. Set the same keys in the Vercel
#  dashboard (Project → Settings → Environment Variables) for deployments.
#
#  Every key below is documented and deliberately EMPTY. The site builds and
#  runs with none of them set — features degrade honestly rather than break.
#
#  ⚠ NEVER prefix a secret with NEXT_PUBLIC_. That prefix ships the value to
#    every visitor's browser. Only the NEXT_PUBLIC_ keys below are public by
#    design.
# ─────────────────────────────────────────────────────────────────────────────


# ── Site (public) ────────────────────────────────────────────────────────────
# The canonical origin, e.g. https://www.lanasmakeover.com
# Drives canonicals, OG URLs, sitemap, robots and the default enquiry From
# address. On Vercel this falls back to VERCEL_URL automatically if unset.
# Must be set before submitting the site for indexing.
NEXT_PUBLIC_SITE_URL=


# ── Content source ───────────────────────────────────────────────────────────
# local     → the files in /src/content   (DEFAULT when unset; needs no keys)
# cms       → a headless CMS via src/lib/content/cms.ts
# instagram → synced + curated Instagram media
CONTENT_SOURCE=


# ── Enquiry delivery (optional) ──────────────────────────────────────────────
# POST /api/contact always validates the enquiry and writes it to the server
# log. The two sinks below are independent and optional; the response reports
# which of them actually happened, and the form tells the bride the truth.
#
# 1. Email, via Resend (https://resend.com). BOTH keys are required before any
#    mail is sent. Until then the form shows its "not connected yet" state.
CONTACT_TO_EMAIL=
RESEND_API_KEY=
# The From address. Must be on a domain verified in Resend. Defaults to
# enquiries@<host of NEXT_PUBLIC_SITE_URL> when unset.
CONTACT_FROM_EMAIL=

# 2. Durable copy in Vercel KV — the last 1,000 enquiries, newest first, under
#    the `enquiries` list key. Set from the Vercel storage integration.
#    A KV failure never fails the enquiry.
KV_REST_API_URL=
KV_REST_API_TOKEN=


# ── Instagram Graph API (SERVER ONLY — never NEXT_PUBLIC_) ────────────────────
# Requires an Instagram Professional account (@lanasmakeover is one) connected
# through a Meta app with instagram_basic / instagram_graph_user_media.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Your own shared secret protecting POST /api/instagram/sync.
# Generate with:  openssl rand -hex 32
INSTAGRAM_SYNC_SECRET=


# ── Headless CMS (optional, for CONTENT_SOURCE=cms) ───────────────────────────
CMS_API_URL=
CMS_API_TOKEN=


# ── Analytics (optional — no IDs are hardcoded anywhere) ─────────────────────
# Google Tag Manager container, e.g. GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=
# GA4 measurement ID, e.g. G-XXXXXXXXXX. Only needed without GTM.
NEXT_PUBLIC_GA_ID=


# ── Admin (optional) ─────────────────────────────────────────────────────────
# The single shared password gating /admin. UNTIL THIS IS SET, /admin RETURNS
# 404 — an unconfigured secret must never mean an open door.
# Generate with:  openssl rand -base64 24
# Rotating it invalidates every existing admin session immediately.
ADMIN_PASSWORD=

# Set by you, read by Vercel Cron. The daily Instagram sync in vercel.json is
# a GET, and Vercel Cron cannot send custom headers — it sends
# `Authorization: Bearer $CRON_SECRET`. Without it the scheduled request is
# just the public status probe and syncs nothing.
# Generate with:  openssl rand -hex 32
CRON_SECRET=
